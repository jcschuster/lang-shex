// Generated by gen/ebnf2lezer.mjs from the grammar in spec/ and gen/overlay.grammar. Do not edit.

// Hand-written part of src/shex.grammar. gen/ebnf2lezer.mjs adds a rule per production and a
// token per terminal of the grammar in spec/. A rule here named like a production must repeat
// the generated body and only adds a @top, props, conflict markers or inline rules. The lines
// starting with @hidden, @unused and @caseInsensitive are read by the generator, not by Lezer.
// gen/CONFLICTS.md explains each entry.

@precedence { exclusion @left }

@skip { whitespace | LineComment | BlockComment }

@external propSource shexHighlighting from "./highlight"

// One rule per production, in the order of the grammar.

@top ShexDoc {
  directive* ((notStartAction | StartActions) statement*)?
}

directive {
  BaseDecl |
  PrefixDecl |
  ImportDecl
}

BaseDecl {
  kwBASE Iriref
}

PrefixDecl {
  kwPREFIX PnameNs Iriref
}

ImportDecl {
  kwIMPORT Iriref
}

notStartAction {
  Start |
  ShapeExprDecl
}

Start {
  kwstart "=" inlineShapeExpression
}

StartActions {
  CodeDecl+
}

statement {
  directive |
  notStartAction
}

ShapeExprDecl {
  kwABSTRACT? ShapeExprLabel Restriction* (shapeExpression | kwEXTERNAL)
}

shapeExpression {
  shapeOr
}

inlineShapeExpression {
  inlineShapeOr
}

shapeOr {
  shapeAnd (kwOR shapeAnd)*
}

inlineShapeOr {
  inlineShapeAnd (kwOR inlineShapeAnd)*
}

shapeAnd {
  shapeNot (kwAND shapeNot)*
}

inlineShapeAnd {
  inlineShapeNot (kwAND inlineShapeNot)*
}

shapeNot {
  kwNOT? ShapeAtom
}

inlineShapeNot {
  kwNOT? InlineShapeAtom
}

ShapeAtom {
  NonLitNodeConstraint shapeOrRef? |
  LitNodeConstraint |
  shapeOrRef NonLitNodeConstraint? |
  "(" shapeExpression ")" |
  "."
}

InlineShapeAtom {
  NonLitInlineNodeConstraint inlineShapeOrRef? |
  LitInlineNodeConstraint |
  inlineShapeOrRef NonLitInlineNodeConstraint? |
  "(" shapeExpression ")" |
  "."
}

shapeOrRef {
  ShapeDefinition |
  ShapeRef
}

inlineShapeOrRef {
  InlineShapeDefinition |
  ShapeRef
}

ShapeRef {
  AtpnameLn |
  AtpnameNs |
  "@" ShapeExprLabel
}

LitNodeConstraint {
  LitInlineNodeConstraint Annotation* semanticActions
}

NonLitNodeConstraint {
  NonLitInlineNodeConstraint Annotation* semanticActions
}

NonLiteralKind {
  kwIRI |
  kwBNODE |
  kwNONLITERAL
}

xsFacet {
  StringFacet |
  NumericFacet
}

StringFacet {
  StringLength Integer |
  Regexp
}

StringLength {
  kwLENGTH |
  kwMINLENGTH |
  kwMAXLENGTH
}

NumericFacet {
  NumericRange NumericLiteral |
  NumericLength Integer
}

NumericRange {
  kwMININCLUSIVE |
  kwMINEXCLUSIVE |
  kwMAXINCLUSIVE |
  kwMAXEXCLUSIVE
}

NumericLength {
  kwTOTALDIGITS |
  kwFRACTIONDIGITS
}

ShapeDefinition {
  (Extension | ExtraPropertySet | kwCLOSED)* "{" tripleExpression? "}" Annotation* semanticActions
}

InlineShapeDefinition {
  (Extension | ExtraPropertySet | kwCLOSED)* "{" tripleExpression? "}"
}

ExtraPropertySet {
  kwEXTRA Predicate+
}

tripleExpression {
  oneOfTripleExpr
}

oneOfTripleExpr {
  groupTripleExpr |
  MultiElementOneOf
}

MultiElementOneOf {
  groupTripleExpr ("|" groupTripleExpr)+
}

groupTripleExpr {
  singleElementGroup |
  MultiElementGroup
}

singleElementGroup {
  unaryTripleExpr (";" | ",")?
}

MultiElementGroup {
  unaryTripleExpr ((";" | ",") unaryTripleExpr)+ (";" | ",")?
}

unaryTripleExpr {
  ("$" TripleExprLabel)? (TripleConstraint | BracketedTripleExpr) |
  Include
}

BracketedTripleExpr {
  "(" tripleExpression ")" Cardinality? Annotation* semanticActions
}

TripleConstraint {
  SenseFlags? Predicate inlineShapeExpression Cardinality? Annotation* semanticActions
}

Cardinality {
  "*" |
  "+" |
  "?" |
  RepeatRange
}

SenseFlags {
  "^"
}

ValueSet {
  "[" valueSetValue* "]"
}

valueSetValue {
  IriRange |
  LiteralRange |
  LanguageRange |
  Exclusion+
}

// valueSetValue* and its exclusion+ both repeat exclusions: consecutive ones form one
// valueSetValue.
Exclusion {
  !exclusion "." (IriExclusion+ | LiteralExclusion+ | LanguageExclusion+)
}

IriRange {
  Iri ("~" IriExclusion*)?
}

IriExclusion {
  "-" Iri "~"?
}

LiteralRange {
  literal ("~" LiteralExclusion*)?
}

LiteralExclusion {
  "-" literal "~"?
}

LanguageRange {
  Langtag ("~" LanguageExclusion*)? |
  "@" "~" LanguageExclusion*
}

LanguageExclusion {
  "-" Langtag "~"?
}

Include {
  "&" TripleExprLabel
}

Annotation {
  "//" Predicate (Iri | literal)
}

semanticActions {
  CodeDecl*
}

// The "%" that ends a semantic action without code is a node of its own, so that only the "%"
// before the name is highlighted with it.
CodeDecl {
  "%" Iri (Code | EmptyCode { "%" })
}

literal {
  RdfLiteral |
  NumericLiteral |
  BooleanLiteral
}

Predicate {
  Iri |
  RdfType
}

Datatype {
  Iri
}

ShapeExprLabel {
  Iri |
  BlankNode
}

TripleExprLabel {
  Iri |
  BlankNode
}

NumericLiteral {
  Integer |
  Decimal |
  Double
}

RdfLiteral {
  LangString |
  String ("^^" Datatype)?
}

BooleanLiteral {
  "true" |
  "false"
}

String {
  StringLiteral1 |
  StringLiteralLong1 |
  StringLiteral2 |
  StringLiteralLong2
}

LangString {
  LangStringLiteral1 |
  LangStringLiteralLong1 |
  LangStringLiteral2 |
  LangStringLiteralLong2
}

Iri {
  Iriref |
  PrefixedName
}

PrefixedName {
  PnameLn |
  PnameNs
}

BlankNode {
  BlankNodeLabel
}

Restriction {
  (kwRESTRICTS | "-") shapeOrRef
}

Extension {
  (kwEXTENDS | "&") extendsShapeExpression
}

extendsShapeExpression {
  extendsShapeOr
}

extendsShapeOr {
  extendsShapeAnd (kwOR extendsShapeAnd)*
}

extendsShapeAnd {
  extendsShapeNot (kwAND extendsShapeNot)*
}

extendsShapeNot {
  kwNOT? ExtendsShapeAtom
}

ExtendsShapeAtom {
  NonLitInlineNodeConstraint inlineShapeOrRef |
  LitInlineNodeConstraint |
  inlineShapeOrRef NonLitInlineNodeConstraint? |
  "(" shapeExpression ")" |
  "."
}

LitInlineNodeConstraint {
  kwLITERAL xsFacet* |
  Datatype xsFacet* |
  ValueSet xsFacet* |
  NumericFacet+
}

NonLitInlineNodeConstraint {
  NonLiteralKind StringFacet* |
  StringFacet+
}

@tokens {
  Code { "{" (![%\\] | "\\" $[%\\] | uchar)* "%" "}" }

  RepeatRange { "{" Integer ("," (Integer | "*")?)? "}" }

  RdfType { "a" }

  Iriref { "<" (![\u{0}- "<>\\^`{-}] | uchar)* ">" }

  PnameNs { pnPrefix? ":" }

  PnameLn { PnameNs pnLocal }

  AtpnameNs { "@" PnameNs }

  AtpnameLn { "@" PnameLn }

  Regexp { "/" (![\u{a}\u{d}/\\] | "\\" $[$(-+\--/?[-^nrt{-}] | uchar)+ "/" $[imsx]* }

  BlankNodeLabel { "_:" (pnCharsU | $[0-9]) ((pnChars | ".")* pnChars)? }

  Langtag { "@" $[A-Za-z]+ ("-" $[0-9A-Za-z]+)* }

  Integer { $[+\-]? $[0-9]+ }

  Decimal { $[+\-]? $[0-9]* "." $[0-9]+ }

  Double { $[+\-]? ($[0-9]+ "." $[0-9]* exponent | "."? $[0-9]+ exponent) }

  exponent { $[Ee] $[+\-]? $[0-9]+ }

  StringLiteral1 { "'" (![\u{a}\u{d}'\\] | echar | uchar)* "'" }

  StringLiteral2 { "\"" (![\u{a}\u{d}"\\] | echar | uchar)* "\"" }

  StringLiteralLong1 { "'''" (("'" | "''")? (!['\\] | echar | uchar))* "'''" }

  StringLiteralLong2 { "\"\"\"" (("\"" | "\"\"")? (!["\\] | echar | uchar))* "\"\"\"" }

  LangStringLiteral1 { "'" (![\u{a}\u{d}'\\] | echar | uchar)* "'" Langtag }

  LangStringLiteral2 { "\"" (![\u{a}\u{d}"\\] | echar | uchar)* "\"" Langtag }

  LangStringLiteralLong1 { "'''" (("'" | "''")? (!['\\] | echar | uchar))* "'''" Langtag }

  LangStringLiteralLong2 { "\"\"\"" (("\"" | "\"\"")? (!["\\] | echar | uchar))* "\"\"\"" Langtag }

  uchar { "\\u" hex hex hex hex | "\\U" hex hex hex hex hex hex hex hex }

  echar { "\\" $["'\\bfnrt] }

  pnCharsBase { $[A-Z] | $[a-z] | $[\u{c0}-\u{d6}] | $[\u{d8}-\u{f6}] | $[\u{f8}-\u{2ff}] | $[\u{370}-\u{37d}] | $[\u{37f}-\u{1fff}] | $[\u{200c}-\u{200d}] | $[\u{2070}-\u{218f}] | $[\u{2c00}-\u{2fef}] | $[\u{3001}-\u{d7ff}] | $[\u{f900}-\u{fdcf}] | $[\u{fdf0}-\u{fffd}] | $[\u{10000}-\u{effff}] }

  pnCharsU { pnCharsBase | "_" }

  pnChars { pnCharsU | "-" | $[0-9] | $[\u{b7}] | $[\u{300}-\u{36f}] | $[\u{203f}-\u{2040}] }

  pnPrefix { pnCharsBase ((pnChars | ".")* pnChars)? }

  pnLocal { (pnCharsU | ":" | $[0-9] | plx) ((pnChars | "." | ":" | plx)* (pnChars | ":" | plx))? }

  plx { percent | pnLocalEsc }

  percent { "%" hex hex }

  hex { $[0-9] | $[A-F] | $[a-f] }

  pnLocalEsc { "\\" ("_" | "~" | "." | "-" | "!" | "$" | "&" | "'" | "(" | ")" | "*" | "+" | "," | ";" | "=" | "/" | "?" | "#" | "@" | "%") }

  whitespace { $[\u{9}-\u{a}\u{d} ]+ }

  LineComment { "#" ![\u{a}\u{d}]* }

  BlockComment { "/*" (![*] | "*" (![/] | "\\/"))* "*/" }

  kwBASE[@name=BASE] { $[Bb] $[Aa] $[Ss] $[Ee] }

  kwPREFIX[@name=PREFIX] { $[Pp] $[Rr] $[Ee] $[Ff] $[Ii] $[Xx] }

  kwIMPORT[@name=IMPORT] { $[Ii] $[Mm] $[Pp] $[Oo] $[Rr] $[Tt] }

  kwstart[@name=start] { $[Ss] $[Tt] $[Aa] $[Rr] $[Tt] }

  kwABSTRACT[@name=ABSTRACT] { $[Aa] $[Bb] $[Ss] $[Tt] $[Rr] $[Aa] $[Cc] $[Tt] }

  kwEXTERNAL[@name=EXTERNAL] { $[Ee] $[Xx] $[Tt] $[Ee] $[Rr] $[Nn] $[Aa] $[Ll] }

  kwOR[@name=OR] { $[Oo] $[Rr] }

  kwAND[@name=AND] { $[Aa] $[Nn] $[Dd] }

  kwNOT[@name=NOT] { $[Nn] $[Oo] $[Tt] }

  kwIRI[@name=IRI] { $[Ii] $[Rr] $[Ii] }

  kwBNODE[@name=BNODE] { $[Bb] $[Nn] $[Oo] $[Dd] $[Ee] }

  kwNONLITERAL[@name=NONLITERAL] { $[Nn] $[Oo] $[Nn] $[Ll] $[Ii] $[Tt] $[Ee] $[Rr] $[Aa] $[Ll] }

  kwLENGTH[@name=LENGTH] { $[Ll] $[Ee] $[Nn] $[Gg] $[Tt] $[Hh] }

  kwMINLENGTH[@name=MINLENGTH] { $[Mm] $[Ii] $[Nn] $[Ll] $[Ee] $[Nn] $[Gg] $[Tt] $[Hh] }

  kwMAXLENGTH[@name=MAXLENGTH] { $[Mm] $[Aa] $[Xx] $[Ll] $[Ee] $[Nn] $[Gg] $[Tt] $[Hh] }

  kwMININCLUSIVE[@name=MININCLUSIVE] { $[Mm] $[Ii] $[Nn] $[Ii] $[Nn] $[Cc] $[Ll] $[Uu] $[Ss] $[Ii] $[Vv] $[Ee] }

  kwMINEXCLUSIVE[@name=MINEXCLUSIVE] { $[Mm] $[Ii] $[Nn] $[Ee] $[Xx] $[Cc] $[Ll] $[Uu] $[Ss] $[Ii] $[Vv] $[Ee] }

  kwMAXINCLUSIVE[@name=MAXINCLUSIVE] { $[Mm] $[Aa] $[Xx] $[Ii] $[Nn] $[Cc] $[Ll] $[Uu] $[Ss] $[Ii] $[Vv] $[Ee] }

  kwMAXEXCLUSIVE[@name=MAXEXCLUSIVE] { $[Mm] $[Aa] $[Xx] $[Ee] $[Xx] $[Cc] $[Ll] $[Uu] $[Ss] $[Ii] $[Vv] $[Ee] }

  kwTOTALDIGITS[@name=TOTALDIGITS] { $[Tt] $[Oo] $[Tt] $[Aa] $[Ll] $[Dd] $[Ii] $[Gg] $[Ii] $[Tt] $[Ss] }

  kwFRACTIONDIGITS[@name=FRACTIONDIGITS] { $[Ff] $[Rr] $[Aa] $[Cc] $[Tt] $[Ii] $[Oo] $[Nn] $[Dd] $[Ii] $[Gg] $[Ii] $[Tt] $[Ss] }

  kwCLOSED[@name=CLOSED] { $[Cc] $[Ll] $[Oo] $[Ss] $[Ee] $[Dd] }

  kwEXTRA[@name=EXTRA] { $[Ee] $[Xx] $[Tt] $[Rr] $[Aa] }

  kwRESTRICTS[@name=RESTRICTS] { $[Rr] $[Ee] $[Ss] $[Tt] $[Rr] $[Ii] $[Cc] $[Tt] $[Ss] }

  kwEXTENDS[@name=EXTENDS] { $[Ee] $[Xx] $[Tt] $[Ee] $[Nn] $[Dd] $[Ss] }

  kwLITERAL[@name=LITERAL] { $[Ll] $[Ii] $[Tt] $[Ee] $[Rr] $[Aa] $[Ll] }

  // A comment, as in shex.js, which skips comments first: "/**/" is also a REGEXP.
  @precedence { BlockComment, Regexp }

  // @detectDelim would only mark ValueSet: the other rules have more than the brackets.
  "("[closedBy=")"] ")"[openedBy="("] "{"[closedBy="}"] "}"[openedBy="{"] "["[closedBy="]"] "]"[openedBy="["]
  "." "|" "~" "-" "=" "^^" "$" "&" "%" ";" "," "//"

  // The longer match first (gen/CONFLICTS.md).
  @precedence { AtpnameLn, "@" }
  @precedence { AtpnameLn, AtpnameNs }
  @precedence { Decimal, "-" }
  @precedence { Decimal, "." }
  @precedence { Decimal, Integer }
  @precedence { Double, "-" }
  @precedence { Double, "." }
  @precedence { Double, Decimal }
  @precedence { Double, Integer }
  @precedence { Integer, "-" }
  @precedence { LangStringLiteral1, StringLiteral1 }
  @precedence { LangStringLiteral2, StringLiteral2 }
  @precedence { LangStringLiteralLong1, StringLiteral1 }
  @precedence { LangStringLiteralLong1, StringLiteralLong1 }
  @precedence { LangStringLiteralLong2, StringLiteral2 }
  @precedence { LangStringLiteralLong2, StringLiteralLong2 }
  @precedence { Langtag, "@" }
  @precedence { PnameLn, "false" }
  @precedence { PnameLn, "true" }
  @precedence { PnameLn, PnameNs }
  @precedence { PnameLn, RdfType }
  @precedence { PnameLn, kwABSTRACT }
  @precedence { PnameLn, kwAND }
  @precedence { PnameLn, kwBASE }
  @precedence { PnameLn, kwBNODE }
  @precedence { PnameLn, kwCLOSED }
  @precedence { PnameLn, kwEXTENDS }
  @precedence { PnameLn, kwEXTERNAL }
  @precedence { PnameLn, kwEXTRA }
  @precedence { PnameLn, kwFRACTIONDIGITS }
  @precedence { PnameLn, kwIMPORT }
  @precedence { PnameLn, kwIRI }
  @precedence { PnameLn, kwLENGTH }
  @precedence { PnameLn, kwLITERAL }
  @precedence { PnameLn, kwMAXEXCLUSIVE }
  @precedence { PnameLn, kwMAXINCLUSIVE }
  @precedence { PnameLn, kwMAXLENGTH }
  @precedence { PnameLn, kwMINEXCLUSIVE }
  @precedence { PnameLn, kwMININCLUSIVE }
  @precedence { PnameLn, kwMINLENGTH }
  @precedence { PnameLn, kwNONLITERAL }
  @precedence { PnameLn, kwNOT }
  @precedence { PnameLn, kwOR }
  @precedence { PnameLn, kwPREFIX }
  @precedence { PnameLn, kwRESTRICTS }
  @precedence { PnameLn, kwTOTALDIGITS }
  @precedence { PnameLn, kwstart }
}
