{
  "name": "lang-shex",
  "private": true,
  "description": "Editor language support for ShEx 2.1, generated from the ShExC grammar of the Shape Expressions Language specification",
  "scripts": {
    "generate": "node gen/ebnf2lezer.mjs",
    "build": "pnpm -r run build",
    "test": "node --test gen/ && pnpm -r test"
  },
  "license": "MIT",
  "engines": {
    "node": "^26"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@shexjs/parser": "1.0.0-alpha.33"
  }
}
